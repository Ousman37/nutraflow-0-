# Copy this file to `.env` (gitignored) and fill in real values locally.
# Never commit `.env` or paste real key values into chat, issues, or logs.

# Anthropic Claude API key — used for AI meal-photo analysis.
CLAUDE_API_KEY=

# RevenueCat public SDK keys — app.revenuecat.com → Project → Apps → API Keys.
# Real public keys only: iOS keys start with "appl_", Android with "goog_".
# A "test_..." Test Store key must never be used outside a local debug build —
# the RevenueCat SDK can crash on launch if configured with one in a
# release/TestFlight/App Store build.
REVENUECAT_IOS_API_KEY=

