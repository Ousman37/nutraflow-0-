# Minimum iOS version required by RevenueCat SDK
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      # permission_handler compiles EVERY permission strategy out by default
      # (each one is gated behind its own macro, defaulting to 0) — without
      # this, Permission.camera.request() silently no-ops on iOS instead of
      # prompting, which would leave the scanner's camera permission check
      # broken. Only enabling PERMISSION_CAMERA since that's the only
      # permission this app requests through this package.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_CAMERA=1'
    end
    flutter_additional_ios_build_settings(target)

    # Must run AFTER flutter_additional_ios_build_settings — for any target
    # that depends on the Flutter engine, that helper deliberately forces
    # EXCLUDED_ARCHS[sdk=iphonesimulator*] back to just "i386" (so a single
    # plugin lacking arm64-simulator support can't break the build for
    # everyone). Apple Silicon Macs run simulators natively on arm64 — the
    # x86_64 slice is never used here, and building it roughly doubles
    # compile time/disk usage for the heaviest pods (gRPC-Core,
    # BoringSSL-GRPC, abseil, Firestore internals) for nothing. Setting this
    # last, for every target, keeps arm64/x86_64 consistent across the whole
    # dependency graph instead of only some targets excluding it (which is
    # what caused "Unsupported Swift architecture" — purchases_flutter still
    # building x86_64 while RevenueCat, which it imports, only had arm64).
    # Device/Release builds are unaffected — this only excludes the
    # simulator SDK.
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
    end
  end
end
